# Copy this file to .env in the project root before running docker compose.
# `docker compose` automatically reads a .env file placed next to
# docker-compose.yml and substitutes these into the file.

# --- MongoDB root (admin) credentials, used only to bootstrap the container ---
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_this_root_password

# --- Application database ---
MONGO_DATABASE=todo-app

# --- App-scoped MongoDB user (least privilege; created by docker/mongo-init) ---
MONGO_APP_USERNAME=todo_app_user
MONGO_APP_PASSWORD=change_this_app_password

# --- Backend ---
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
FRONTEND_URL=http://localhost:3000

# --- Email (optional - only needed for password reset emails) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@todoapp.com
