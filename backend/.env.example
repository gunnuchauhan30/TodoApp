PORT=5000
NODE_ENV=development

# MongoDB (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/todo-app?retryWrites=true&w=majority

# Auth: short-lived access token + longer-lived rotating refresh token
JWT_SECRET=change_this_to_a_long_random_string
# JWT_REFRESH_SECRET=optional_separate_secret_for_refresh_tokens
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

FRONTEND_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000   # comma-separated; defaults to allow-all in dev

# Logging / uploads (optional)
LOG_LEVEL=info
# LOG_TO_FILE=true
# UPLOAD_DIR=uploads

# Email (optional - password reset emails; without it dev mode shows the reset link on screen)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@todoapp.com
